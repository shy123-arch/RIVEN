# RIVEN external paths.
#
#   cp configs/paths.env.example configs/paths.env
#   edit the values, then:  set -a; . configs/paths.env; set +a
#
# Every variable is optional when the default location inside this repository
# is used (data/egoreal, cache/, state/).  Point them at real storage for a
# full run; large assets must NOT be committed.

# Repository root (defaults to the directory that contains src/).
RIVEN_ROOT=

# EgoReReal release used by the paper (split.json, data_manifest.json,
# motion/humanml263_full.npz, motion/gt22_full.npz).
# Paper main table: umrm_v2280_unseen_20261112 (1854 / 213 / 213, source-disjoint).
RIVEN_DATA=

# Experiment outputs (checkpoints, generations, metrics).  Prefer a real
# filesystem (cpfs) over a FUSE/object-store mount for anything that writes
# SQLite or rewrites files in place.
RIVEN_STATE=

# Regenerable caches: Qwen hidden states, VQ checkpoints, video tensors.
RIVEN_CACHE=

# HERO_release @475774d (MIT) plus patches/hero-gen.patch applied.
RIVEN_HERO=

# The single HumanML3D RVQ checkpoint used to initialise the tokenizer's first
# quantizer (81 MB).  Ship it separately from the HERO checkout if convenient.
RIVEN_HML3D_RVQ=

# Qwen3-VL-4B-Instruct (ModelScope/HuggingFace snapshot).
RIVEN_QWEN=

# Optional adapter passed to `sft.py --init-adapter`.  The paper SFT starts
# from the 10k ego pre-training adapter (s10k_pt/epoch1), not from scratch.
RIVEN_SFT_INIT_ADAPTER=

# LoRA adapter used as the condition encoder.  Paper main table: epoch2,
# selected by lowest VAL NLL per token (see docs/REPRODUCE.md).
RIVEN_SFT_ADAPTER=

# Cache-directory suffix.  Empty for the paper main table.  `_sft_ep1`
# selects the epoch1 cache used by the earlier v4-split experiments only.
RIVEN_CACHE_SUFFIX=

# Per-video cache written by the V->T data pipeline (one <id>.pt per clip).
RIVEN_VIDEO_CACHE=

# Clip locations.  The release manifest records absolute server paths, so set
# RIVEN_CLIP_ROOT (rebase after `clips/`) or RIVEN_CLIP_MAP (id -> relative path).
RIVEN_CLIP_ROOT=
RIVEN_CLIP_MAP=

# Official TMR assets.  The clean evaluator only needs `official/` and
# `sources.json` (for joints -> 263-D guoh3dfeats).
RIVEN_TMR_ASSETS=

# Paper evaluator: one directory per evaluator seed, each with best.tar.
# Layout: $RIVEN_CLEAN_EVAL_ROOT/evaluator_hml3d_clean_s<seed>/best.tar
RIVEN_CLEAN_EVAL_ROOT=
# Frozen evaluation corpus: motion/, text/, meta/, {train,val,test}_ids.txt
RIVEN_CLEAN_EVAL_DATA=
RIVEN_EVAL_SEEDS=20261111,20261112,20261113

# Legacy E2 evaluator only (not used by the paper).  Contains E2_best.pt.
RIVEN_EVAL_DIR=

# TMR motion embeddings used by the optional NCE term (build_tmr_motion_emb_v4.py).
RIVEN_TMR_MOTION_EMB=

# Optional HumanML3D-prepared head initialisation.  The paper's main_scratch
# configuration does NOT use it.
RIVEN_INIT_H1=

# Python interpreters for the three environments.
RIVEN_PY_QWEN=
RIVEN_PY=
RIVEN_PY_EVAL=

# Compatibility aliases read by the V->T modules (src/riven/sft).
# Leave empty to let RIVEN_* above take effect.
VHO_DATA=
VHO_CACHE=
VHO_QWEN=
VHO_RUNS=
